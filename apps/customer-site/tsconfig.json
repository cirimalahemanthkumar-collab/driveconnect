{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../web/components/**/*.ts",
    "../web/components/**/*.tsx",
    "../web/lib/**/*.ts",
    "../web/lib/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "../web/app",
    "../web/node_modules",
    "../web/.next"
  ]
}